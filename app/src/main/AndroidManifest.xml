<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.anthonydevs.intento3.pasteleria">

    <!-- 🔒 Permiso para conectarse a Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Base.Theme.Intento3">

        <!-- Actividad principal (Inicio/Login) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actividad del catálogo -->
        <activity
            android:name=".CatalogoActivity"
            android:exported="false" />

        <!-- Actividad de registro -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Actividad de perfil / cuenta -->
        <activity
            android:name=".CuentaActivity"
            android:exported="false" />

        <!-- Actividad del carrito -->
        <activity
            android:name=".CarritoActivity"
            android:exported="false" />

        <!-- Actividad de pago -->
        <activity
            android:name=".PagoActivity"
            android:exported="false" />

    </application>

</manifest>
